# Maintainer: rl-lang contributors <https://github.com/rl-lang/rl-lang>
pkgname=rl-lang
pkgver=2.2.1
pkgrel=1
pkgdesc="Programming language with first-class VM and C transpiler"
arch=('x86_64' 'aarch64')
url="https://github.com/rl-lang/rl-lang"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'zlib')
makedepends=('cargo')
source=("$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('5457715e77d7a86cb8304b269a0865d1eca2f94c1bf1f02acd6b55f0031f7d6a')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --all-features
}

package() {
  cd "$pkgname-$pkgver"
  for bin in rl rlc rlt rlrepl rlsp rldocs rlm; do
    install -Dm755 "target/release/$bin" "$pkgdir/usr/bin/$bin"
  done
  install -Dm644 man/rl.1 "$pkgdir/usr/share/man/man1/rl.1"
  install -Dm644 man/rl.info "$pkgdir/usr/share/info/rl.info"
  install -Dm644 LICENSE-MIT.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT.md"
  install -Dm644 LICENSE-APACHE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE.md"
}
